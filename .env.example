# ═══════════════════════════════════════════
# 基础配置
# ═══════════════════════════════════════════

# 运行环境：development / production
APP_ENV=development
APP_NAME=bilibili-summary-cloud
APP_HOST=0.0.0.0
APP_PORT=8000

# 对外访问根地址（生成预签名 URL、回调地址时用）
APP_BASE_URL=http://127.0.0.1:8000

# 加密密钥：用于加密用户凭证（DeepSeek Key / B站 Cookie）
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=CHANGE_ME_fernet_key

# 会话签名密钥
JWT_SECRET=CHANGE_ME_jwt_secret
JWT_EXPIRE_HOURS=168

# ═══════════════════════════════════════════
# 数据库
# ═══════════════════════════════════════════
#
# 支持三种后端，改 URL 即可切换，代码不用动：
#
#   MySQL（宝塔面板用户用这个）
#     DATABASE_URL=mysql+aiomysql://用户:密码@127.0.0.1:3306/库名?charset=utf8mb4
#     DATABASE_URL_SYNC=mysql+pymysql://用户:密码@127.0.0.1:3306/库名?charset=utf8mb4
#
#   Postgres
#     DATABASE_URL=postgresql+asyncpg://用户:密码@127.0.0.1:5432/库名
#     DATABASE_URL_SYNC=postgresql+psycopg://用户:密码@127.0.0.1:5432/库名
#
#   SQLite（只能开发用，多进程会锁冲突，生产别用）
#     DATABASE_URL=sqlite+aiosqlite:///./data/dev.db
#
# 【注意】MySQL 的库、用户、密码要在宝塔面板「数据库」页里先建好，
# 字符集必须选 utf8mb4（否则中文和 emoji 会乱码/报错）。

# 异步连接（应用运行时用）
DATABASE_URL=mysql+aiomysql://bsum:请改成你的密码@127.0.0.1:3306/bsum?charset=utf8mb4

# 同步连接（Alembic 迁移用）
DATABASE_URL_SYNC=mysql+pymysql://bsum:请改成你的密码@127.0.0.1:3306/bsum?charset=utf8mb4

# ═══════════════════════════════════════════
# Redis / 任务队列
# ═══════════════════════════════════════════

REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=bsum_tasks

# 单用户同时进行的任务上限
MAX_TASKS_PER_USER=1
# 全局并发 Worker 数（2 核机器建议 2；内存紧张改 1）
WORKER_CONCURRENCY=2

# ═══════════════════════════════════════════
# 腾讯云 COS（对象存储）
# ═══════════════════════════════════════════

# 【重要】COS 地域必须与服务器地域一致，否则 ASR 拉取音频会产生外网下行流量费
COS_REGION=ap-guangzhou
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=your-bucket-1250000000
# 自定义域名（可选，留空则用默认域名）
COS_DOMAIN=

# ═══════════════════════════════════════════
# 腾讯云 ASR（语音识别）
# ═══════════════════════════════════════════

ASR_SECRET_ID=
ASR_SECRET_KEY=
ASR_REGION=ap-guangzhou
# 引擎：16k_zh_en_2.0 为大模型2.0版，支持中英混说 + 31种方言
ASR_ENGINE=16k_zh_en_2.0
# 结果返回格式：3 = 按标点分段（适用字幕场景，不额外收费）
# 注意：4（语义分段）与 5（口语转书面语）为增值付费项，勿开
ASR_RES_TEXT_FORMAT=3
# 单用户每月免费额度（秒），用于超限预警。10 小时 = 36000 秒
ASR_MONTHLY_QUOTA_SEC=36000
# 轮询间隔与超时
ASR_POLL_INTERVAL=4
ASR_POLL_TIMEOUT=1800

# ═══════════════════════════════════════════
# AI
# ═══════════════════════════════════════════

# 全局 DeepSeek Key（管理员在后台配置，写入数据库后此项仅作首次初始化）
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
# 是否允许用户自带 Key（否则统一用管理员配置的 Key）
ALLOW_USER_OWN_KEY=true

# ═══════════════════════════════════════════
# 下载与代理
# ═══════════════════════════════════════════

# 全局代理（YouTube 访问用），留空则不使用
HTTP_PROXY=
# 全局 B站 Cookie 文件路径（管理员可上传，用户也可自带）
GLOBAL_COOKIE_FILE=
# FFmpeg 可执行文件路径（容器内为 ffmpeg）
FFMPEG_PATH=ffmpeg

# ═══════════════════════════════════════════
# 业务参数（沿用本地版调优结果，勿随意改动）
# ═══════════════════════════════════════════

# 长文本分级
MAP_REDUCE_THRESHOLD=12000
HIERARCHICAL_THRESHOLD=20000
CHUNK_SIZE=6500
CHUNK_OVERLAP=600
# 输出比例与上下限
SUMMARY_RATIO=0.35
SUMMARY_MIN_WORDS=1000
SUMMARY_MAX_WORDS=8000

# ═══════════════════════════════════════════
# 管理员初始化
# ═══════════════════════════════════════════

# 首次启动时自动创建的管理员账号
# ⚠️ 部署到服务器前务必改成强密码；这个值只在「账号不存在」时生效
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_admin_password
