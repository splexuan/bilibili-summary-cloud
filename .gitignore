# 环境与密钥
.env
.env.local
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
# 切换解释器版本时留下的旧虚拟环境备份（如 .venv310.bak）
# 动辄几百 MB，只占仓库体积，绝不入库
.venv*/
venv/
.Python

# 数据与缓存
data/
temp/
*.db
*.sqlite3
cookies.txt
proxy.txt

# 运行期状态（bt_start.sh 写 PID 用）
.run/

# ACME 证书校验目录（宝塔签发 HTTPS 时生成的一次性文件，
# 每次续期都会变，且只对当前域名有效，不入库）
.well-known/

# 宝塔 AI 项目管理面板的元数据（面板配置 / PID）
# 内含本机域名、端口、绝对路径，换台机器就不成立，不入库
.aiproject/

# 模型与工具
models/
tools/

# 日志
logs/
*.log

# IDE
.idea/
.vscode/
.DS_Store

# 临时调试产物（开发过程中随手写的脚本与输出，不入库）
#
# ⚠️ 注意这里必须排除 __init__.py！
# `_*.py` 这个 glob 会连带匹配 `__init__.py`（下划线开头的 .py 文件），
# 而它恰恰是 Python 包必需的。漏掉的后果是 clone 下来直接
# `ImportError: cannot import name '__version__' from 'app'`。
# 所有 __init__.py 一律强制入库。
_*.py
!_*/**
!__init__.py
!**/__init__.py
_*.txt
